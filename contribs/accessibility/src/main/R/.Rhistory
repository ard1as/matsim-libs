# ================================
# 1. LOAD LIBRARIES
# ================================
library(dplyr)
library(readr)
library(ggplot2)
# ================================
# 2. FILE PATHS
# ================================
base_file   <- "base_car.csv"
policy_file <- "policy_car.csv"
# ================================
# 3. READ DATA
# ================================
base   <- read_csv(base_file)
policy <- read_csv(policy_file)
# Optional: print column names
print(colnames(base))
# ================================
# 2. FILE PATHS
# ================================
base_file   <- "./compa/base_car.csv"
policy_file <- "./compa/policy_car.csv"
# ================================
# 3. READ DATA
# ================================
base   <- read_csv(base_file)
# ================================
# 2. FILE PATHS
# ================================
base_file   <- "base_car.csv"
policy_file <- "policy_car.csv"
# ================================
# 3. READ DATA
# ================================
base   <- read_csv(base_file)
policy <- read_csv(policy_file)
# Optional: print column names
print(colnames(base))
print(colnames(policy))
# ================================
# 4. STANDARDIZE COLUMN NAMES
# ================================
# Ensure both datasets have the same essential columns
required_cols <- c("personId", "time", "mode", "homeX", "homeY", "accessibility")
missing_base   <- setdiff(required_cols, names(base))
missing_policy <- setdiff(required_cols, names(policy))
if (length(missing_base) > 0)
stop(paste("Base CSV missing columns:", paste(missing_base, collapse=", ")))
if (length(missing_policy) > 0)
stop(paste("Policy CSV missing columns:", paste(missing_policy, collapse=", ")))
# ================================
# 5. MERGE THE TWO DATASETS
# ================================
merged <- base %>%
rename(access_base = accessibility) %>%
inner_join(
policy %>% rename(access_policy = accessibility),
by = c("personId", "time", "mode"),  # merge by these identifiers
suffix = c("_base", "_policy")
)
# ================================
# 6. COMPUTE ACCESSIBILITY CHANGES
# ================================
merged <- merged %>%
mutate(
delta = access_policy - access_base,
pct_change = 100 * (access_policy - access_base) / access_base
)
# ================================
# 7. WRITE OUTPUT CSV
# ================================
write_csv(merged, "car_accessibility_comparison.csv")
cat("✔ Output written to car_accessibility_comparison.csv\n")
# Histogram of changes
ggplot(merged, aes(x = delta)) +
geom_histogram(bins = 40, fill="steelblue", color="white") +
theme_minimal() +
ggtitle("Distribution of Accessibility Change (Policy - Base) for Car") +
xlab("Δ Accessibility") +
ylab("Count")
ggsave("hist_delta_car.png")
# Scatter: base vs policy
ggplot(merged, aes(x = access_base, y = access_policy)) +
geom_point(alpha = 0.4) +
geom_abline(slope=1, intercept=0, color="red") +
theme_minimal() +
ggtitle("Base vs Policy Accessibility (Car)") +
xlab("Base Accessibility") +
ylab("Policy Accessibility")
ggsave("scatter_base_vs_policy_car.png")
# Spatial scatter colored by delta (quick pseudo-map)
ggplot(merged, aes(x = homeX, y = homeY, color = delta)) +
geom_point(alpha = 0.6) +
scale_color_viridis_c() +
theme_minimal() +
coord_equal() +
ggtitle("Spatial Distribution of Accessibility Change (Car)") +
xlab("X") +
ylab("Y")
View(best_movies)
View(base_car)
View(base_car)
View(base_car)
View(merged)
library(readr)
library(dplyr)
library(ggplot2)
library(tidyr)
#column names in CSVs
age_col   <- "age"
score_col <- "accessibility"
#load data and rename acc score column name
no_mod <- read_csv("person_based_accessibility (walk + nomods).csv", show_col_types = FALSE) %>%
rename(age = all_of(age_col),
acc_default = all_of(score_col)) %>%
select(personId, age, acc_default)
age_mod <- read_csv("person_based_accessibility (walk + age).csv", show_col_types = FALSE) %>%
rename(age = all_of(age_col),
acc_age = all_of(score_col)) %>%
select(personId, age, acc_age)
age_mod %>% view()
#merge df
df <- no_mod %>%
inner_join(age_mod, by = c("personId", "age")) %>%
pivot_longer(cols = c(acc_default, acc_age),
names_to = "source",
values_to = "score") %>%
mutate(source = recode(source,
acc_default = "Person-based w/o age modifier",
acc_age     = "Person-based w/ age modifier"))
#age grouping
df <- df %>%
mutate(age_group = case_when(
age <= 14 ~ "0–14",
age <= 29 ~ "15–29",
age <= 59 ~ "30–59",
TRUE      ~ "60+"
)) %>%
mutate(
age_group = factor(age_group, levels = c("0–14", "15–29", "30–59", "60+")),
source    = factor(source, levels = c("Person-based w/o age modifier",
"Person-based w/ age modifier"))
)
#Summarise df to one bar per age group per panel
summary_df <- df %>%
group_by(source, age_group) %>%
summarise(mean_acc = mean(score, na.rm = TRUE),
n = n(), .groups = "drop")
#plot
p <- ggplot(summary_df, aes(x = age_group, y = mean_acc)) +
geom_col(width = 0.7, fill = "grey60") +
geom_text(aes(label = round(mean_acc, 2)),
vjust = ifelse(summary_df$mean_acc < 0, 1.2, -0.5),
size = 4) +
facet_wrap(~ source, nrow = 1) +
labs(x = "age group", y = "mean accessibility") +
theme_minimal(base_size = 13) +
theme(
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold")
)
print(p)
