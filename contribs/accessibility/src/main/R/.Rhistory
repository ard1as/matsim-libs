#basic age distribution
bw <- 5   # 5-year bins
df %>%
ggplot(aes(x = age)) +
geom_histogram(
binwidth = bw,
boundary = 0,                # bins: [0,5), [5,10), ...
fill = "steelblue",
color = "black"
) +
geom_text(
stat = "bin",
binwidth = bw,               # must match binwidth above
aes(label = ..count..),
vjust = -0.5,
size = 3
) +
scale_x_continuous(
breaks = seq(0, max(df$age), by = bw)   # ticks at 0,5,10,...
) +
theme_minimal() +
labs(title = "Age Distribution (Berlin 1% Sample)")
