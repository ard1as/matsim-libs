# CONFIG
# ------
BEZIRKE_SHP_PATH <- "Berlin_Bezirke.shp"
OUT_DIR   <- "outputs"
FIG_DIR   <- file.path(OUT_DIR, "figures")
TABLE_DIR <- file.path(OUT_DIR, "tables")
DATA_DIR  <- file.path(OUT_DIR, "data")
TOL <- 1e-6
dir.create(FIG_DIR, recursive = TRUE, showWarnings = FALSE)
dir.create(TABLE_DIR, recursive = TRUE, showWarnings = FALSE)
dir.create(DATA_DIR, recursive = TRUE, showWarnings = FALSE)
# 1. VALIDATION + CLEANING
# ------------------------
required_cols <- c(
"personId", "mode", "age", "sex", "economic_status",
"income", "restricted_mobility", "homeX", "homeY", "accessibility"
)
check_cols <- function(df, name) {
missing <- setdiff(required_cols, names(df))
if (length(missing) > 0) {
stop(name, " is missing columns: ", paste(missing, collapse = ", "), call. = FALSE)
}
}
clean_car_df <- function(df, scenario_name) {
check_cols(df, scenario_name)
df %>%
filter(mode == "car") %>%
mutate(
scenario = scenario_name,
personId = as.character(personId),
accessibility = as.numeric(accessibility),
age = as.numeric(age),
income = as.numeric(income),
restricted_mobility = as.logical(restricted_mobility),
sex = factor(sex, levels = c("f", "m")),
economic_status = factor(
economic_status,
levels = c("very_low", "low", "medium", "high", "very_high"),
ordered = TRUE
),
# CHANGED: exact income bins (only these 10 values)
income_bin = case_when(
income == 499  ~ "499",
income == 500  ~ "500",
income == 900  ~ "900",
income == 1500 ~ "1500",
income == 2000 ~ "2000",
income == 2600 ~ "2600",
income == 3000 ~ "3000",
income == 3600 ~ "3600",
income == 4600 ~ "4600",
income == 5600 ~ "5600",
TRUE ~ NA_character_
),
income_bin = factor(
income_bin,
levels = c("499","500","900","1500","2000","2600","3000","3600","4600","5600"),
ordered = TRUE
),
restricted_mobility = factor(
restricted_mobility,
levels = c(FALSE, TRUE),
labels = c("No restriction", "Restricted mobility")
),
age_group = case_when(
age < 15 ~ "<15",
age <= 29 ~ "15–29",
age <= 44 ~ "30–44",
age <= 59 ~ "45–59",
TRUE ~ "60+"
),
age_group = factor(
age_group,
levels = c("<15", "15–29", "30–44", "45–59", "60+"),
ordered = TRUE
)
) %>%
filter(
!is.na(personId),
!is.na(accessibility),
!is.na(age_group),
!is.na(homeX),
!is.na(homeY),
!is.na(income_bin) # CHANGED
)
}
