# ==== 1) Point these to your files ====
no_mod_file  <- "person_based_accessibility (walk + default).csv"
age_mod_file <- "person_based_accessibility (walk + age).csv"
# ==== 2) Tell me your column names here (change if different) ====
age_col   <- "age"
score_col <- "accessibility"
# ---- Load + standardize columns ----
no_mod <- read_csv(no_mod_file, show_col_types = FALSE) %>%
rename(age = all_of(age_col), score = all_of(score_col)) %>%
mutate(source = "Person-based w/o age modifier")
age_mod <- read_csv(age_mod_file, show_col_types = FALSE) %>%
rename(age = all_of(age_col), score = all_of(score_col)) %>%
mutate(source = "Person-based w/ age modifier")
# ---- Combine datasets ----
df <- bind_rows(no_mod, age_mod) %>%
filter(!is.na(age), !is.na(score))
# ---- Age bins (edit cut points if you need different groups) ----
df <- df %>%
mutate(age_group = case_when(
age <= 14 ~ "0–14",
age <= 29 ~ "15-29",
age <= 59 ~ "30–59",
TRUE      ~ "60+"
)) %>%
mutate(age_group = factor(age_group, levels = c("0–14", "15–29", "30-59", "65+")),
source    = factor(source, levels = c("Person-based w/o age modifier",
"Person-based w/ age modifier")))
# ==== 3) Plot: distributions per age group, side-by-side facets ====
p <- ggplot(df, aes(x = age_group, y = score)) +
geom_violin(width = 0.9, alpha = 0.25, linewidth = 0.2, color = NA) +
geom_boxplot(width = 0.25, outlier.alpha = 0.25) +
stat_summary(fun = mean, geom = "point", shape = 21, size = 2, fill = "white") +
facet_wrap(~ source, nrow = 1, scales = "fixed") +
labs(x = "age", y = "accessibility") +
theme_minimal(base_size = 12) +
theme(
panel.grid.minor = element_blank(),
axis.title.y = element_text(margin = margin(r = 8)),
strip.text = element_text(face = "bold")
)
print(p)
View(p)
View(p)
# ---- Age bins (edit cut points if you need different groups) ----
df <- df %>%
mutate(age_group = case_when(
age <= 14 ~ "0–14",
age <= 29 ~ "15-29",
age <= 59 ~ "30–59",
TRUE      ~ "60+"
)) %>%
mutate(age_group = factor(age_group, levels = c("0–14", "15–29", "30-59", "65+")),
source    = factor(source, levels = c("Person-based w/o age modifier",
"Person-based w/ age modifier")))
# ==== 3) Plot: distributions per age group, side-by-side facets ====
p <- ggplot(df, aes(x = score)) +
geom_histogram(binwidth = 0.1, color = "black", fill = "grey80") +
scale_y_reverse() +   # <-- flips histogram (since scores are negative)
facet_grid(age_group ~ source) +
labs(
x = "Accessibility score",
y = "Count (inverted)",
title = "Accessibility Score Distribution by Age Group"
) +
theme_minimal(base_size = 13) +
theme(
strip.text = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
print(p)
# install.packages(c("readr","dplyr","ggplot2"))  # if needed
library(readr)
library(dplyr)
library(ggplot2)
# --- Files ---
no_mod_file  <- "person_based_accessibility (walk + default).csv"
age_mod_file <- "person_based_accessibility (walk + age).csv"
# --- Column names in your CSVs ---
age_col   <- "age"
score_col <- "accessibility"
# --- Load, standardize, label sources ---
no_mod <- read_csv(no_mod_file, show_col_types = FALSE) %>%
rename(age = all_of(age_col), score = all_of(score_col)) %>%
mutate(source = "Person-based w/o age modifier")
age_mod <- read_csv(age_mod_file, show_col_types = FALSE) %>%
rename(age = all_of(age_col), score = all_of(score_col)) %>%
mutate(source = "Person-based w/ age modifier")
df <- bind_rows(no_mod, age_mod) %>%
filter(!is.na(age), !is.na(score))
# --- Your age groups (0–14, 15–29, 30–59, 60+) ---
df <- df %>%
mutate(age_group = case_when(
age <= 14 ~ "0–14",
age <= 29 ~ "15–29",
age <= 59 ~ "30–59",
TRUE      ~ "60+"
)) %>%
mutate(
age_group = factor(age_group, levels = c("0–14", "15–29", "30–59", "60+")),
source    = factor(source, levels = c("Person-based w/o age modifier",
"Person-based w/ age modifier"))
)
# --- Summarise to one bar per age group per panel (mean accessibility) ---
summary_df <- df %>%
group_by(source, age_group) %>%
summarise(mean_access = mean(score, na.rm = TRUE),
n = n(), .groups = "drop")
# --- Plot: two panels side-by-side, bars by age group ---
p <- ggplot(summary_df, aes(x = age_group, y = mean_access)) +
geom_col(width = 0.7) +
facet_wrap(~ source, nrow = 1) +
labs(x = "age group", y = "mean accessibility") +
theme_minimal(base_size = 13) +
theme(
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold")
)
print(p)
library(readr)
library(dplyr)
library(ggplot2)
library(tidyr)
# --- Files ---
no_mod_file  <- "person_based_accessibility (walk + default).csv"
age_mod_file <- "person_based_accessibility (walk + age).csv"
# --- Column names in your CSVs ---
age_col   <- "age"
score_col <- "accessibility"   # adjust later if needed (e.g., teleportedWalk_accessibility)
# --- Load each dataset and give unique score column names ---
no_mod <- read_csv(no_mod_file, show_col_types = FALSE) %>%
rename(age = all_of(age_col),
acc_default = all_of(score_col)) %>%
select(age, acc_default)
age_mod <- read_csv(age_mod_file, show_col_types = FALSE) %>%
rename(age = all_of(age_col),
acc_age = all_of(score_col)) %>%
select(age, acc_age)
# --- Join by age & reshape to long format ---
df <- no_mod %>%
inner_join(age_mod, by = "age") %>%   # keeps only rows that exist in both datasets
pivot_longer(cols = c(acc_default, acc_age),
names_to = "source",
values_to = "score") %>%
mutate(source = recode(source,
acc_default = "Person-based w/o age modifier",
acc_age     = "Person-based w/ age modifier"))
# --- Age grouping ---
df <- df %>%
mutate(age_group = case_when(
age <= 14 ~ "0–14",
age <= 29 ~ "15–29",
age <= 59 ~ "30–59",
TRUE      ~ "60+"
)) %>%
mutate(
age_group = factor(age_group, levels = c("0–14", "15–29", "30–59", "60+")),
source    = factor(source, levels = c("Person-based w/o age modifier",
"Person-based w/ age modifier"))
)
# --- Summarise to one bar per age group per panel ---
summary_df <- df %>%
group_by(source, age_group) %>%
summarise(mean_access = mean(score, na.rm = TRUE),
n = n(), .groups = "drop")
# --- Plot ---
p <- ggplot(summary_df, aes(x = age_group, y = mean_access)) +
geom_col(width = 0.7) +
facet_wrap(~ source, nrow = 1) +
labs(x = "age group", y = "mean accessibility") +
theme_minimal(base_size = 13) +
theme(
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold")
)
print(p)
# --- Plot ---
p <- ggplot(summary_df, aes(x = age_group, y = mean_access)) +
geom_col(width = 0.7, fill = "grey60") +
geom_text(aes(label = round(mean_access, 2)),
vjust = ifelse(summary_df$mean_access < 0, 1.2, -0.5),
size = 4) +
facet_wrap(~ source, nrow = 1) +
labs(x = "age group", y = "mean accessibility") +
theme_minimal(base_size = 13) +
theme(
panel.grid.minor = element_blank(),
strip.text = element_text(face = "bold")
)
print(p)
View(no_mod)
View(no_mod)
View(age_mod)
View(age_mod)
