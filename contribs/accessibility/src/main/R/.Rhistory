st_join(bezirke_sf[, bez_col, drop = FALSE]) %>%
st_drop_geometry() %>%
rename(bezirk = all_of(bez_col))
}
car_base_df   <- join_bezirk(car_base_df)
# Person-based accessibility analysis pipeline
# Base vs Policy – car
# CRS: EPSG:25832
# --------------------------------------------
suppressPackageStartupMessages({
library(dplyr)
library(ggplot2)
library(sf)
library(readr)
})
# CONFIG
# ------
BEZIRKE_SHP_PATH <- "Berlin_Bezirke.shp"
OUT_DIR   <- "outputs"
FIG_DIR   <- file.path(OUT_DIR, "figures")
TABLE_DIR <- file.path(OUT_DIR, "tables")
DATA_DIR  <- file.path(OUT_DIR, "data")
TOL <- 1e-6
dir.create(FIG_DIR, recursive = TRUE, showWarnings = FALSE)
dir.create(TABLE_DIR, recursive = TRUE, showWarnings = FALSE)
dir.create(DATA_DIR, recursive = TRUE, showWarnings = FALSE)
# 1. VALIDATION + CLEANING
# ------------------------
required_cols <- c(
"personId", "mode", "age", "sex", "economic_status",
"income", "restricted_mobility", "homeX", "homeY", "accessibility"
)
check_cols <- function(df, name) {
missing <- setdiff(required_cols, names(df))
if (length(missing) > 0) {
stop(name, " is missing columns: ", paste(missing, collapse = ", "), call. = FALSE)
}
}
clean_car_df <- function(df, scenario_name) {
check_cols(df, scenario_name)
df %>%
filter(mode == "car") %>%
mutate(
scenario = scenario_name,
personId = as.character(personId),
accessibility = as.numeric(accessibility),
age = as.numeric(age),
income = as.numeric(income),
restricted_mobility = as.logical(restricted_mobility),
sex = factor(sex, levels = c("f", "m")),
economic_status = factor(
economic_status,
levels = c("very_low", "low", "medium", "high", "very_high"),
ordered = TRUE
),
restricted_mobility = factor(
restricted_mobility,
levels = c(FALSE, TRUE),
labels = c("No restriction", "Restricted mobility")
),
age_group = case_when(
age < 15 ~ "<15",
age <= 29 ~ "15–29",
age <= 44 ~ "30–44",
age <= 59 ~ "45–59",
TRUE ~ "60+"
),
age_group = factor(
age_group,
levels = c("<15", "15–29", "30–44", "45–59", "60+"),
ordered = TRUE
)
) %>%
filter(
!is.na(personId),
!is.na(accessibility),
!is.na(age_group),
!is.na(homeX),
!is.na(homeY)
)
}
car_base_df   <- clean_car_df(car_base_mods,   "base")
car_policy_df <- clean_car_df(car_policy_mods, "policy")
message("Rows (car only):")
message("  Base:   ", nrow(car_base_df))
message("  Policy: ", nrow(car_policy_df))
# 2. SPATIAL JOIN (BEZIRK)
# ------------------------
Sys.setenv(SHAPE_RESTORE_SHX = "YES")  # helps if .shx is missing/corrupt
bezirke_sf <- st_read(BEZIRKE_SHP_PATH, quiet = TRUE)
if (is.na(st_crs(bezirke_sf))) st_crs(bezirke_sf) <- 25832
if (st_crs(bezirke_sf)$epsg != 25832) {
bezirke_sf <- st_transform(bezirke_sf, 25832)
}
# Fix invalid geometries (prevents failed spatial joins / NA joins)
if (any(!st_is_valid(bezirke_sf))) {
bezirke_sf <- st_make_valid(bezirke_sf)
}
# Ensure polygons are single-part where needed (optional but can help)
bezirke_sf <- st_cast(bezirke_sf, "MULTIPOLYGON", warn = FALSE)
bez_col <- setdiff(names(bezirke_sf), attr(bezirke_sf, "sf_column"))[1]
join_bezirk <- function(df) {
st_as_sf(df, coords = c("homeX", "homeY"), crs = 25832, remove = FALSE) %>%
st_join(bezirke_sf[, bez_col, drop = FALSE]) %>%
st_drop_geometry() %>%
rename(bezirk = all_of(bez_col))
}
car_base_df   <- join_bezirk(car_base_df)
car_policy_df <- join_bezirk(car_policy_df)
# 3. PERSON-LEVEL COMPARISON
# --------------------------
car_compare_df <- car_base_df %>%
select(
personId, sex, age_group, economic_status,
restricted_mobility, income, bezirk, accessibility
) %>%
rename(access_base = accessibility) %>%
inner_join(
car_policy_df %>%
select(personId, accessibility) %>%
rename(access_policy = accessibility),
by = "personId"
) %>%
mutate(
delta = access_policy - access_base,
changed = abs(delta) > TOL
)
write_csv(
car_compare_df,
file.path(DATA_DIR, "car_person_level_base_vs_policy.csv")
)
message("Matched persons: ", nrow(car_compare_df))
message("Share with change: ", round(mean(car_compare_df$changed), 4))
# 4. AGGREGATION FUNCTION
# -----------------------
summarise_delta <- function(df, group_vars) {
df %>%
group_by(across(all_of(group_vars))) %>%
summarise(
n = n(),
mean_delta = mean(delta),
median_delta = median(delta),
sd_delta = sd(delta),
p25 = quantile(delta, 0.25),
p75 = quantile(delta, 0.75),
share_improved = mean(delta > TOL),
share_worsened = mean(delta < -TOL),
.groups = "drop"
)
}
# 5. TABLE OUTPUTS
# ----------------
write_csv(
summarise_delta(car_compare_df, "age_group"),
file.path(TABLE_DIR, "car_delta_by_age_group.csv")
)
write_csv(
summarise_delta(car_compare_df, "economic_status"),
file.path(TABLE_DIR, "car_delta_by_economic_status.csv")
)
write_csv(
summarise_delta(car_compare_df, "sex"),
file.path(TABLE_DIR, "car_delta_by_sex.csv")
)
write_csv(
summarise_delta(car_compare_df, "restricted_mobility"),
file.path(TABLE_DIR, "car_delta_by_restricted_mobility.csv")
)
write_csv(
summarise_delta(car_compare_df %>% filter(!is.na(bezirk)), "bezirk"),
file.path(TABLE_DIR, "car_delta_by_bezirk.csv")
)
# Scatterplot: Base vs Policy
p_scatter <- ggplot(car_compare_df, aes(access_base, access_policy)) +
geom_point(alpha = 0.35, size = 1) +
geom_abline(slope = 1, intercept = 0, color = "red") +
coord_equal() +
labs(
title = "Accessibility: Base vs Policy (Car)",
x = "Accessibility (Base)",
y = "Accessibility (Policy)"
) +
theme_minimal()
print(p_scatter)
ggsave(file.path(FIG_DIR, "car_scatter_base_vs_policy.png"), p_scatter, dpi = 300)
# Boxplot by economic status
p_box_econ <- ggplot(car_compare_df, aes(economic_status, delta)) +
geom_boxplot(outlier_alpha = 0.3) +
labs(
title = "Δ Accessibility (Policy − Base) by Economic Status (Car)",
x = "Economic status",
y = "Δ Accessibility"
) +
theme_minimal()
print(p_box_econ)
ggsave(file.path(FIG_DIR, "car_box_delta_by_economic_status.png"), p_box_econ, dpi = 300)
# Boxplot by age group
p_box_age <- ggplot(car_compare_df, aes(age_group, delta)) +
geom_boxplot(outlier_alpha = 0.3) +
labs(
title = "Δ Accessibility (Policy − Base) by Age Group (Car)",
x = "Age group",
y = "Δ Accessibility"
) +
theme_minimal()
print(p_box_age)
ggsave(file.path(FIG_DIR, "car_box_delta_by_age_group.png"), p_box_age, dpi = 300)
message("Pipeline complete. Outputs written to: ", normalizePath(OUT_DIR))
View(p_box_econ)
View(car_compare_df)
# Person-based accessibility analysis pipeline
